    {"id": 8, "title": "Async order P95 / P99", "description": "Runtime metric from Redis acceptance timestamp to consumer completion; run artifact SQL is canonical.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95,sum by(le)(rate(hotshop_seckill_order_end_to_end_latency_seconds_bucket[5m])))", "legendFormat": "P95"}, {"refId": "B", "expr": "histogram_quantile(0.99,sum by(le)(rate(hotshop_seckill_order_end_to_end_latency_seconds_bucket[5m])))", "legendFormat": "P99"}], "fieldConfig": {"defaults": {"unit": "s"}}, "gridPos": {"h": 7, "w": 12, "x": 0, "y": 21}},
