# Copy these values to an env file outside the repository and replace every
# change-me value. The checked-in values are public local-development placeholders.
COMPOSE_PROJECT_NAME=hotshop
TZ=UTC

MYSQL_IMAGE=mysql:8.0.46
MYSQL_DATABASE=hotShop
MYSQL_ROOT_PASSWORD=change-me-local-mysql
MYSQL_PORT=4306
MYSQL_TIME_ZONE=+00:00
MYSQL_MAX_CONNECTIONS=300
MYSQL_SLOW_QUERY_SECONDS=1
MYSQL_MEMORY_LIMIT=1g
MYSQL_CPU_LIMIT=1.5
FLYWAY_IMAGE=flyway/flyway:11.20.3-alpine

REDIS_IMAGE=redis:8.8.1-alpine
REDIS_CACHE_PASSWORD=change-me-local-redis-cache
REDIS_CACHE_PORT=7379
REDIS_CACHE_MEMORY_LIMIT=384m
HOTSHOP_REDIS_CACHE_TIMEOUT=2s
REDIS_SECKILL_PASSWORD=change-me-local-redis-seckill
REDIS_SECKILL_PORT=7380
REDIS_SECKILL_MEMORY_LIMIT=640m
HOTSHOP_REDIS_SECKILL_TIMEOUT=2s
HOTSHOP_SECKILL_RESERVATION_TTL=7d
HOTSHOP_SECKILL_IDEMPOTENCY_TTL=24h
HOTSHOP_SECKILL_ACTIVITY_RETENTION=7d
HOTSHOP_SECKILL_ORDER_CONSUMER_ENABLED=true
HOTSHOP_SECKILL_ORDER_GROUP=hotshop-order-v1
HOTSHOP_SECKILL_ORDER_CONSUMER_PREFIX=order
HOTSHOP_SECKILL_ORDER_READ_BATCH=20
HOTSHOP_SECKILL_ORDER_READ_BLOCK=2s
HOTSHOP_SECKILL_ORDER_POLL_DELAY=250ms
HOTSHOP_SECKILL_ORDER_DISCOVERY_INTERVAL=10s
HOTSHOP_SECKILL_ORDER_CLAIM_IDLE=30s
HOTSHOP_SECKILL_ORDER_CLAIM_BATCH=20
HOTSHOP_SECKILL_ORDER_RETRY_INITIAL_BACKOFF=1s
HOTSHOP_SECKILL_ORDER_RETRY_MAX_BACKOFF=5m
HOTSHOP_SECKILL_ORDER_RETRY_MULTIPLIER=2.0
HOTSHOP_SECKILL_ORDER_DETERMINISTIC_FAILURE_ATTEMPTS=3
HOTSHOP_SECKILL_ORDER_TIMEOUT=15m
HOTSHOP_SECKILL_PAYMENT_TIMEOUT=15m
HOTSHOP_SECKILL_RECONCILIATION_INTERVAL=5m
HOTSHOP_SECKILL_RECONCILIATION_BATCH=100
HOTSHOP_SECKILL_RECONCILIATION_DRY_RUN=true
HOTSHOP_SECKILL_RECONCILIATION_AUTO_REPAIR=false

RABBITMQ_IMAGE=rabbitmq:4.0.7-management-alpine@sha256:011e8d48c9d4e9e0bc94d709e2b1b68fccf51de6680bcda302566dff0465764f
RABBITMQ_PROJECT_IMAGE=hotshop-rabbitmq:4.0.7
RABBITMQ_DEFAULT_USER=hotshop
RABBITMQ_DEFAULT_PASS=change-me-local-rabbitmq
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=6672
RABBITMQ_MANAGEMENT_PORT=15673
HOTSHOP_OUTBOX_ENABLED=true
HOTSHOP_OUTBOX_BATCH_SIZE=50
HOTSHOP_OUTBOX_POLL_DELAY=250ms
HOTSHOP_OUTBOX_LEASE=30s
HOTSHOP_OUTBOX_CONFIRM_TIMEOUT=5s
HOTSHOP_OUTBOX_INITIAL_BACKOFF=1s
HOTSHOP_OUTBOX_MAX_BACKOFF=5m
HOTSHOP_OUTBOX_BACKOFF_MULTIPLIER=2
HOTSHOP_OUTBOX_MAX_ATTEMPTS=8
HOTSHOP_LEGACY_ORDER_TIMEOUT=15m
HOTSHOP_MOCK_PAYMENT_ENABLED=false
# Local demo only. Supply at least 32 UTF-8 bytes outside Git before enabling.
HOTSHOP_MOCK_PAYMENT_SECRET=
HOTSHOP_MOCK_PAYMENT_ALLOWED_CLOCK_SKEW=5m
HOTSHOP_MOCK_PAYMENT_CALLBACK_URL=http://portal-service:8080/provider-callbacks/v1/mock-payment
HOTSHOP_MOCK_PAYMENT_HTTP_TIMEOUT=3s
HOTSHOP_MOCK_PAYMENT_RETRY_DELAY=2s
HOTSHOP_MOCK_PAYMENT_MAX_DELIVERY_ATTEMPTS=5
HOTSHOP_MOCK_PAYMENT_MAX_SIMULATION_DELAY=1h
HOTSHOP_MOCK_PAYMENT_MAX_DUPLICATE_COUNT=10
HOTSHOP_MOCK_PAYMENT_MAX_CALLBACK_BODY_BYTES=4096
HOTSHOP_SECKILL_PAYMENT_EXPIRED_RETRY_DELAY=2s
HOTSHOP_SECKILL_PAYMENT_EXPIRED_CONFIRM_TIMEOUT=3s
HOTSHOP_SECKILL_PAYMENT_EXPIRED_MAX_DELIVERY_ATTEMPTS=5
RABBITMQ_MEMORY_LIMIT=768m

SPRING_PROFILES_ACTIVE=
PORTAL_PORT=8080
ADMIN_PORT=8088
TASK_PORT=8888
PORTAL_IMAGE=hotshop-portal:local
ADMIN_IMAGE=hotshop-admin:local
TASK_IMAGE=hotshop-task:local

# Run .\script\generate-auth-keys.ps1 before starting the app profile.
# This directory is Git-ignored; Compose mounts only each process's required files read-only.
HOTSHOP_KEY_DIR=./.local/keys/hotshop
HOTSHOP_SECURE_COOKIES=false
HOTSHOP_JWT_CLOCK_SKEW_SECONDS=30
HOTSHOP_USER_ACCESS_TTL_SECONDS=900
HOTSHOP_ADMIN_ACCESS_TTL_SECONDS=900
HOTSHOP_AGENT_DELEGATION_TTL_SECONDS=300
HOTSHOP_AGENT_ASSERTION_MAX_TTL_SECONDS=60
HOTSHOP_AGENT_PURCHASE_DRAFT_TTL=10m
HOTSHOP_AGENT_PURCHASE_CONFIRMATION_TTL=2m
HOTSHOP_REFRESH_TTL_SECONDS=604800
HOTSHOP_TRUST_FORWARDED_HEADERS=false
HOTSHOP_TRUSTED_PROXY_ADDRESSES=

# Python Agent process. FakeModel is the safe default and does not require a paid-model key.
AGENT_IMAGE=hotshop-agent:local
AGENT_PORT=8090
AGENT_MEMORY_LIMIT=512m
AGENT_ENVIRONMENT=local
# Offline-safe default. For a real model prefer deepseek; qwen remains supported.
AGENT_MODEL_PROVIDER=fake
AGENT_SESSION_TTL_SECONDS=3600
AGENT_RUN_TTL_SECONDS=900
AGENT_TOKEN_EXCHANGE_TIMEOUT_SECONDS=3
AGENT_TOOL_TIMEOUT_SECONDS=3
AGENT_QWEN_API_KEY=
AGENT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_QWEN_MODEL=qwen-plus
# Configure current provider pricing explicitly; zero keeps cost metrics disabled.
AGENT_QWEN_INPUT_COST_PER_MILLION_USD=0
AGENT_QWEN_OUTPUT_COST_PER_MILLION_USD=0
AGENT_DEEPSEEK_API_KEY=
AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_DEEPSEEK_MODEL=deepseek-v4-flash
AGENT_DEEPSEEK_INPUT_COST_PER_MILLION_USD=0
AGENT_DEEPSEEK_OUTPUT_COST_PER_MILLION_USD=0
# Static knowledge only. Product, inventory, order, reservation, and payment facts never use Qdrant.
QDRANT_IMAGE=qdrant/qdrant:v1.15.4
QDRANT_PORT=6333
QDRANT_MEMORY_LIMIT=512m
QDRANT_CPU_LIMIT=0.75
AGENT_RAG_ENABLED=true
AGENT_QDRANT_TIMEOUT_SECONDS=2
AGENT_QDRANT_MAX_RETRIES=1
AGENT_KNOWLEDGE_TENANT_ID=hotshop
AGENT_KNOWLEDGE_CHUNK_SIZE=800
AGENT_KNOWLEDGE_CHUNK_OVERLAP=80
AGENT_RAG_TOP_K=3
AGENT_RAG_MINIMUM_SCORE=0.15
AGENT_RAG_MAX_CONTEXT_CHARS=6000
# deterministic is offline, stable, and the required test/CI default.
AGENT_EMBEDDING_PROVIDER=deterministic
AGENT_EMBEDDING_DIMENSION=128
AGENT_EMBEDDING_MAX_INPUT_CHARS=8000
AGENT_EMBEDDING_MAX_BATCH_SIZE=10
AGENT_EMBEDDING_TIMEOUT_SECONDS=5
AGENT_BAILIAN_EMBEDDING_API_KEY=
AGENT_BAILIAN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_BAILIAN_EMBEDDING_MODEL=text-embedding-v4
AGENT_MODEL_TIMEOUT_SECONDS=15
AGENT_MODEL_MAX_RETRIES=2
AGENT_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_CIRCUIT_RECOVERY_SECONDS=30
AGENT_GLOBAL_CONCURRENCY_LIMIT=16
AGENT_USER_CONCURRENCY_LIMIT=2

# TASK-11 local observability profile. All images are deliberately pinned.
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.0
LOKI_IMAGE=grafana/loki:3.5.3
TEMPO_IMAGE=grafana/tempo:2.8.1
ALLOY_IMAGE=grafana/alloy:v1.10.2
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
TEMPO_PORT=3200
ALLOY_PORT=12345
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_MEMORY_LIMIT=512m
GRAFANA_MEMORY_LIMIT=512m
LOKI_MEMORY_LIMIT=512m
TEMPO_MEMORY_LIMIT=512m
ALLOY_MEMORY_LIMIT=384m
GRAFANA_ADMIN_USER=admin
# Public local-development placeholder; replace outside Git for shared machines.
GRAFANA_ADMIN_PASSWORD=change-me-local-grafana
HOTSHOP_DEPLOYMENT_ENVIRONMENT=local
HOTSHOP_TRACE_SAMPLING_PROBABILITY=1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://alloy:4318/v1/traces
